# MedMatch Rx — Configuration Example
# Copy this file to .env and configure for your local environment.

# Vision AI Configuration (Google AI Studio)
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# SQLite Database Location
DATABASE_URL=sqlite:///./data/medmatch.db

# Server Bind Settings (Defaults to localhost for security)
PORT=8000
HOST=127.0.0.1

# Optional Pharmacist PIN (Unset = open operator, Set = requires header X-Pharmacist-PIN)
PHARMACIST_PIN=

# CORS Security: comma-separated list of allowed frontend origins (No wildcard '*' in production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Upload Security Limits
MAX_UPLOAD_SIZE_MB=10

# Online Medicine Reference API (NLM RxNav REST API)
# Official documentation: https://lhncbc-portal.lhcaws-prod-pub.nlm.nih.gov/RxNav/APIs/RxNormAPIs.html
RXNORM_API_BASE=https://rxnav.nlm.nih.gov/REST
RXNORM_REQUEST_TIMEOUT=3.0
RXNORM_CACHE_TTL_SECONDS=3600
