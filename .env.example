# MedMatch Rx Configuration
# Obtain your Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Current Gemini model as per official documentation (gemini-3.8-flash is recommended for multimodal OCR tasks)
GEMINI_MODEL=gemini-3.8-flash

# Database path (defaults to SQLite in backend/data/medmatch.db)
DATABASE_URL=sqlite:///./data/medmatch.db
PORT=8000
HOST=0.0.0.0
